modules = ["python-3.11", "nodejs-20", "java-graalvm22.3", "web"]

[nix]
channel = "stable-25_05"

[agent]
expertMode = true

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Claros homepage"

[[workflows.workflow]]
name = "Claros homepage"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "/nix/store/51gywl5jn4nna7al9waj142pw4vfhy0k-nodejs-22.19.0/bin/node node_modules/vite/bin/vite.js --host 0.0.0.0 --port 5000 --strictPort"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[[ports]]
localPort = 5000
externalPort = 5000

[[ports]]
localPort = 23636
externalPort = 80
