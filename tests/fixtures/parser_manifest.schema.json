{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ParserEvalLabel",
  "type": "object",
  "required": ["pdf", "title", "questions"],
  "properties": {
    "pdf": { "type": "string" },
    "title": { "type": "string" },
    "questions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "text_contains"],
        "properties": {
          "id": { "type": "integer" },
          "start_line": { "type": "integer" },
          "end_line": { "type": "integer" },
          "text_contains": { "type": "string" }
        }
      }
    },
    "negatives": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["line", "must_not_start_question"],
        "properties": {
          "line": { "type": "integer" },
          "must_not_start_question": { "type": "boolean" },
          "reason": { "type": "string" }
        }
      }
    }
  }
}
