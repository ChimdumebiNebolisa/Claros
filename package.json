{
  "name": "claros-reconstruction",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12 <23"
  },
  "scripts": {
    "dev": "vite",
    "dev:api": "node server/index.mjs",
    "build": "tsc -b && vite build",
    "format": "prettier --check src/v2 src/main.tsx src/styles/tailwind.css src/styles/v2.css \"tests/gate*.test.ts*\" tests/e2e tests/storybook .storybook scripts playwright.config.ts playwright.storybook.config.ts vite.config.ts vitest.config.ts components.json eslint.config.js package.json tsconfig.json",
    "lint": "eslint src/v2 src/main.tsx tests .storybook --max-warnings=0",
    "typecheck": "tsc -b --pretty false",
    "check:dependencies": "node scripts/verify-gate1-dependencies.mjs",
    "check:bundles": "node scripts/verify-gate1-bundles.mjs",
    "preview": "vite preview",
    "start": "node server/index.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test:storybook": "npm run build-storybook && playwright test --config playwright.storybook.config.ts",
    "test:a11y": "npm run test:storybook",
    "capture:visual": "node scripts/capture-gate2-screenshots.mjs",
    "check:visual": "node scripts/verify-gate2-screenshots.mjs",
    "generate:api": "node scripts/openapi-contract.mjs --write",
    "check:api": "node scripts/openapi-contract.mjs",
    "test:e2e": "npm run build && playwright test",
    "test:e2e:gate3": "npm run build && playwright test --config playwright.gate3.config.ts",
    "ci": "npm run format && npm run lint && npm run typecheck && npm run check:dependencies && npm run check:api && npm test && npm run test:storybook && npm run build && npm run check:bundles"
  },
  "dependencies": {
    "@embedpdf/core": "2.15.0",
    "@embedpdf/engines": "2.15.0",
    "@embedpdf/models": "2.15.0",
    "@embedpdf/pdfium": "2.15.0",
    "@embedpdf/plugin-document-manager": "2.15.0",
    "@embedpdf/plugin-render": "2.15.0",
    "@embedpdf/react-pdf-viewer": "2.15.0",
    "@fontsource-variable/inter": "5.3.0",
    "@tanstack/react-query": "5.102.8",
    "@untitledui/file-icons": "0.0.9",
    "@untitledui/icons": "0.0.22",
    "@xstate/react": "6.1.0",
    "clsx": "2.1.1",
    "lucide-react": "0.468.0",
    "motion": "12.43.0",
    "openapi-fetch": "0.17.0",
    "radix-ui": "1.6.7",
    "react": "19.2.8",
    "react-aria": "3.52.0",
    "react-aria-components": "1.21.0",
    "react-dom": "19.2.8",
    "react-dropzone": "14.4.1",
    "react-pdf": "9.2.1",
    "react-resizable-panels": "2.1.9",
    "react-router-dom": "7.18.2",
    "tailwind-merge": "3.6.0",
    "tailwindcss": "4.3.3",
    "tailwindcss-animate": "1.0.7",
    "tailwindcss-react-aria-components": "2.2.0",
    "tw-animate-css": "1.4.0",
    "xstate": "5.32.5",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.1",
    "@eslint/js": "9.39.4",
    "@playwright/test": "1.58.2",
    "@storybook/addon-a11y": "10.5.10",
    "@storybook/react-vite": "10.5.10",
    "@tailwindcss/postcss": "4.3.3",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "22.20.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "5.2.0",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.6",
    "globals": "17.12.0",
    "jsdom": "27.4.0",
    "msw": "2.15.0",
    "msw-storybook-addon": "3.0.0",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.6",
    "storybook": "10.5.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.69.0",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  },
  "overrides": {
    "ws": "8.21.3"
  }
}
