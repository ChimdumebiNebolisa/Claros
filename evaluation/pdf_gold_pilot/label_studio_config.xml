<View>
  <Header value="Claros PDF gold-label pilot" />
  <Text name="selection_context" value="$selection_context" />
  <Image name="page_image" value="$image" zoom="true" rotateControl="true" />

  <Header value="Page role (one per page)" />
  <Choices name="page_role" toName="page_image" choice="single" showInline="true" required="true">
    <Choice value="student_worksheet" />
    <Choice value="teacher_guide" />
    <Choice value="answer_key" />
    <Choice value="reference_material" />
    <Choice value="mixed" />
    <Choice value="unknown" />
  </Choices>

  <Header value="Regions: review every gray/green/yellow prediction; predictions are suggestions, not gold" />
  <RectangleLabels name="region_labels" toName="page_image">
    <Label value="student_prompt" background="#E53935" />
    <Label value="teacher_instruction" background="#8E24AA" />
    <Label value="answer_key_content" background="#D81B60" />
    <Label value="example" background="#FB8C00" />
    <Label value="rubric" background="#6D4C41" />
    <Label value="standard" background="#3949AB" />
    <Label value="reference_value" background="#00897B" />
    <Label value="visual_anchor" background="#00ACC1" />
    <Label value="navigation" background="#757575" />
    <Label value="decorative" background="#BDBDBD" />
    <Label value="other" background="#546E7A" />
    <Label value="task_prompt_bbox" background="#FF1744" />
    <Label value="response_line" background="#43A047" />
    <Label value="response_box" background="#2E7D32" />
    <Label value="response_table_cell" background="#7CB342" />
    <Label value="response_checkbox" background="#C0CA33" />
    <Label value="response_drawing_canvas" background="#039BE5" />
    <Label value="response_free_space" background="#5E35B1" />
  </RectangleLabels>

  <Header value="Per-region provenance and task structure" />
  <TextArea name="physical_block_id" toName="page_image" perRegion="true" editable="false" rows="1" />
  <TextArea name="physical_text" toName="page_image" perRegion="true" editable="false" rows="2" />
  <TextArea name="gold_task_id" toName="page_image" perRegion="true" rows="1" placeholder="Required on task_prompt_bbox and each member prompt block" />
  <TextArea name="parent_task_id" toName="page_image" perRegion="true" rows="1" placeholder="Blank for a top-level task" />
  <TextArea name="subpart" toName="page_image" perRegion="true" rows="1" placeholder="For example 3a or b" />
  <TextArea name="task_type" toName="page_image" perRegion="true" rows="1" placeholder="short_text, long_text, numeric, choice, drawing, table, visual, other" />
  <Number name="accessible_task_order" toName="page_image" perRegion="true" min="1" />
  <Choices name="student_answerable" toName="page_image" perRegion="true" choice="single" showInline="true">
    <Choice value="yes" />
    <Choice value="no" />
    <Choice value="uncertain" />
  </Choices>
  <Choices name="response_type" toName="page_image" perRegion="true" choice="single" showInline="true">
    <Choice value="line" />
    <Choice value="box" />
    <Choice value="table_cell" />
    <Choice value="checkbox" />
    <Choice value="drawing_canvas" />
    <Choice value="free_space" />
    <Choice value="none" />
  </Choices>
  <Choices name="response_safety" toName="page_image" perRegion="true" choice="single" showInline="true">
    <Choice value="safe_physical" />
    <Choice value="ambiguous" />
    <Choice value="unsafe" />
    <Choice value="side_panel_only" />
  </Choices>

  <Header value="Relations" />
  <Relations name="relations" toName="page_image">
    <Relation value="parent_task_to_subpart" />
    <Relation value="prompt_to_response_region" />
    <Relation value="prompt_to_visual_anchor" />
  </Relations>

  <Header value="Page notes and task manifest" />
  <TextArea name="task_manifest_json" toName="page_image" rows="10" placeholder="Use for response_type=none/side_panel_only and any structure not expressible by regions. Follow annotation-protocol.md." />
  <TextArea name="annotator_notes" toName="page_image" rows="4" />
</View>
