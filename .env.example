VITE_API_BASE_URL=/api
CLAROS_SESSION_SECRET=replace-with-a-local-secret
CLAROS_OPENAI_API_KEY=replace-with-a-server-side-key
CLAROS_SEMANTIC_ENGINE=openai
CLAROS_SEMANTIC_MODEL=gpt-5.6-luna
CLAROS_REALTIME_ENGINE=openai
CLAROS_REALTIME_MODEL=gpt-realtime-2.1
CLAROS_PDF_ENGINE=openpdf
CLAROS_OPENPDF_JAVA_COMMAND=java
CLAROS_OPENPDF_JVM_HEAP_MIB=192
CLAROS_PUBLIC_ORIGIN=http://127.0.0.1:8080
CLAROS_LOCAL_STORAGE_PATH=.local/claros-v2
# Set CLAROS_OPENPDF_QPDF_PATH only when qpdf is not on PATH.
