# Copy to .env and fill in values. See README "Environment Variables".
GEMINI_API_KEY=
GCS_BUCKET_NAME=
GOOGLE_CLOUD_PROJECT=
GEMINI_TEXT_MODEL=gemini-2.5-flash
DOCUMENT_SEMANTIC_PROVIDER=gemini
SILVER_BENCHMARK_MAX_COST_USD=5.00
MAX_PDF_PAGES=8
MAX_WORKSHEET_QUESTIONS=40
MAX_SEMANTIC_PROVIDER_CALLS=8
SEMANTIC_PROVIDER_TIMEOUT_MS=15000

# Production accepts only sequential short-answer worksheets with a deterministic
# blank line group, blank box, writable area, or text field directly below each prompt.
# PDF_PARSER_MODE=hybrid
# ENABLE_PADDLEOCR=false
# ALLOW_SYNCHRONOUS_PADDLEOCR=false
# ENABLE_DOCUMENT_SEMANTICS=false
# ALLOW_SYNCHRONOUS_DOCUMENT_SEMANTICS=false
# ENABLE_DOCUMENT_TASK_AUTO_APPROVE=false
# PADDLEOCR_DPI=150
# PADDLEOCR_CPU_THREADS=4

# Optional: enable GET /debug-gemini for local Gemini connectivity checks (default off)
# ENABLE_DEBUG_GEMINI=true
# Optional: expose legacy local-only diagnostics such as GET /test (default off)
# ENABLE_DEBUG_ROUTES=true

# Session/write contract (production should set a strong secret)
# APP_ENV=development  # Canonical environment name; legacy CLAROS_ENV must match if set.
# SESSION_HMAC_SECRET=
# USE_MANIFEST=true
# SESSION_TTL_HOURS=48
# ASSIGNMENT_TTL_DAYS=90
# MAX_UPLOADS_PER_MINUTE=6  # Production default; development default is 60.
# MAX_PROVIDER_SESSIONS_PER_MINUTE=20  # Production default; development default is 120.
# MAX_WRITES_PER_MINUTE=30
# MAX_MUTATIONS_PER_MINUTE=30
# MAX_SESSION_STARTS_PER_MINUTE=30
# MAX_PAGE_RENDERS_PER_MINUTE=120
# MAX_CONCURRENT_UPLOADS=1  # Production default; development default is 2.

# Optional for local GCS access (pick one approach):
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
# Or: gcloud auth application-default login
